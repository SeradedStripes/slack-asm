; Macros and structs for defining slack-asm commands
; Included by commands.asm and slash-commands.asm

%define MAX_CMDS 16
%define CMD_NAMESPACED 1
%define WS_TEXT 0x1

struc help_entry
    .text_ptr resq 1
    .text_len resd 1
    .pad      resd 1
endstruc

; Registration entry auto-generated by def_slash_cmd // def_complex_cmd
; into a linker section so cmd_register_all iterates them automatically.
struc reg_entry
    .name_ptr  resq 1
    .name_len  resq 1
    .handler   resq 1
    .help_ptr  resq 1
    .help_len  resq 1
endstruc

struc handler_args
    .channel_id      resq 1
    .channel_id_len  resq 1
    .user_id_ptr     resq 1
    .user_id_len     resq 1
    .envelope_id     resq 1
    .envelope_id_len resq 1
    .thread_ts       resq 1
    .thread_ts_len   resq 1
    .response_url    resq 1
    .response_url_len resq 1
endstruc

; Define a simple command with a canned response.
; %1 = identifier prefix (e.g., ping -> str_ping, ping_handler, msg_ping)
; %2 = command name string (e.g., "ping")
; %3 = response text string (e.g., "pong")
; %4 = help description string
%macro def_slash_cmd 4
  section .rodata
  str_%1: db %2
  str_%1_len: equ $ - str_%1
  msg_%1: db %3
  msg_%1_len: equ $ - msg_%1
  help_%1: db "/slack-asm %2 - %4", 0x0A
  help_%1_len: equ $ - help_%1
  section .text
  global %1_handler
  %1_handler:
      mov r10, [rsp + 8]
      push rbx
      push r12
      mov r8, [r10 + handler_args.thread_ts]
      test r8, r8
      jnz .%1_thread
      mov rdi, [r10 + handler_args.envelope_id]
      mov esi, [r10 + handler_args.envelope_id_len]
      lea rdx, [rel msg_%1]
      mov ecx, msg_%1_len
      call slack_send_response
      jmp .%1_done
  .%1_thread:
      lea rdx, [rel msg_%1]
      mov ecx, msg_%1_len
      call send_cpm_threaded
  .%1_done:
      pop r12
      pop rbx
      ret
  reg_entry %1
%endmacro

; Define a complex command with a custom handler.
; %1 = identifier (e.g., help -> str_help, help_handler)
; %2 = command name string (e.g., "help")
; %3 = help description string
; You must provide %1_handler after this macro.
%macro def_complex_cmd 3
  section .rodata
  str_%1: db %2
  str_%1_len: equ $ - str_%1
  help_%1: db "/slack-asm %2 - %3", 0x0A
  help_%1_len: equ $ - help_%1
  section .text
  global %1_handler
  reg_entry %1
%endmacro

; Auto-registration entry: placed in section `regcmds` so GNU ld
; provides __start_regcmds / __stop_regcmds for iteration.
; Called automatically from def_slash_cmd / def_complex_cmd.
%macro reg_entry 1
section regcmds
  dq str_%1
  dq str_%1_len
  dq %1_handler
  dq help_%1
  dq help_%1_len
section .text
%endmacro

; Not needed — def_slash_cmd / def_complex_cmd auto-call reg_entry now.
